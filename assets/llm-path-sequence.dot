digraph LlmPathSequence {
  graph [
    bgcolor="#F7F9FC",
    pad="0.28",
    rankdir=LR,
    nodesep="0.34",
    ranksep="0.45",
    splines=polyline,
    fontname="Helvetica",
    fontsize=18,
    labelloc=t,
    label="LLM guardrail path"
  ];
  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#A8B3C2",
    fontcolor="#172033",
    fontname="Helvetica",
    fontsize=11,
    margin="0.16,0.11",
    penwidth=1.2
  ];
  edge [
    color="#596779",
    fontcolor="#3E4B5D",
    fontname="Helvetica",
    fontsize=9,
    arrowsize=0.7,
    penwidth=1.2
  ];

  request [label="A2A request or\nbenchmark case", fillcolor="#FFF7DB", color="#D8A72D"];
  quarkus [label="Quarkus guardrail hook\nbuild state + questions", fillcolor="#EAF3FF", color="#3B82B6"];
  prompt [label="Stateless judge prompt\nsystem rules + request JSON", fillcolor="#FFF1E7", color="#C96B2C"];
  vpce [label="Bedrock Runtime\nVPC interface endpoint", fillcolor="#E8F7EE", color="#4B9B68"];
  bedrock [label="Claude Sonnet 5.5\ngenerate contract JSON", fillcolor="#F1ECFF", color="#7456B8"];
  validate [label="Strict parse + typed validation\nprobabilities -> policy thresholds", fillcolor="#FFFFFF", color="#7456B8"];
  result [label="ALLOW | BLOCK | ESCALATE\n+ latency + tokens + cost", fillcolor="#E8F7EE", color="#4B9B68"];

  request -> quarkus [label=" 1  input"];
  quarkus -> prompt [label=" 2  serialize"];
  prompt -> vpce [label=" 3  private HTTPS"];
  vpce -> bedrock [label=" 4  InvokeModel"];
  bedrock -> validate [label=" 5  generated JSON"];
  validate -> result [label=" 6  decide + record"];
}
