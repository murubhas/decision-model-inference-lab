# Copy to .env for local runs. Never commit the populated .env file.
TYPESAFE_API_KEY=replace-with-typesafe-api-key
TYPESAFE_MODEL=jev-latest

# Live benchmark defaults. AWS credentials come from the standard SDK chain.
BEDROCK_AWS_REGION=us-east-2
BEDROCK_GUARDRAIL_MODEL_ID=global.anthropic.claude-sonnet-5-5
STRANDS_DECIDER_BASE_URL=http://127.0.0.1:8000
STRANDS_DECIDER_MODEL=StrandsAgents/strands-decider-2B-hobson-v19

# Optional overrides for a deployed environment.
# AWS_PROFILE=replace-with-profile
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# APP_MCP_URL=https://mcp.example.com/mcp
# OIDC_AUTH_SERVER_URL=https://id.example.com/realms/decision-model-lab
# OIDC_CLIENT_ID=decision-inference-agent
# MCP_CLIENT_SECRET=replace-with-oidc-client-secret
# BEDROCK_ENDPOINT_OVERRIDE=https://replace-with-private-bedrock-endpoint
